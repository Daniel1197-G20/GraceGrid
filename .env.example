# ==============================================================================
# GraceGrid Frontend Environment Configuration (React + Vite)
# ==============================================================================
# Public anonymous Supabase keys safe for frontend client consumption (.env.local).
# NEVER put service_role or Brevo API keys in your frontend .env files.

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon / Public API Key
VITE_ADMIN_EMAIL=gracegrid4@gmail.com
VITE_ADMIN_PASSWORD=gracegrid2026
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Crowdfunding Gateway URLs & Paystack Inline Public Key
# Add your Paystack Public Key (pk_live_... or pk_test_...) to enable instant in-app modal checkout without redirecting:
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_PAYSTACK_PAYMENT_URL=https://paystack.com/pay/gracegrid
VITE_FLUTTERWAVE_PAYMENT_URL=https://flutterwave.com/pay/gracegrid

# ==============================================================================
# Supabase Edge Functions Secrets (Configure via Supabase CLI or Dashboard)
# ==============================================================================
# Command to set secrets:
# npx supabase secrets set BREVO_API_KEY=xkeysib-... ADMIN_ALERT_EMAIL=gracegrid4@gmail.com BREVO_SENDER_EMAIL=gracegrid4@gmail.com
#
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here
# BREVO_LIST_ID=2                             # (Optional) Brevo Contact List ID for waitlist subscribers
# BREVO_TEMPLATE_ID=1                         # (Optional) Brevo Transactional Email Template ID
# BREVO_SENDER_EMAIL=gracegrid4@gmail.com     # Sender email address verified in Brevo (e.g. your account email)
# BREVO_SENDER_NAME="GraceGrid Sanctuary"     # Sender display name
# ADMIN_ALERT_EMAIL=gracegrid4@gmail.com      # Email address that receives new signup notifications
# ADMIN_API_KEY=your-custom-admin-secret-key  # Secret key to authorize send-phase-update broadcasts
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
